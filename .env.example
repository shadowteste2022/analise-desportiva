# Copie para .env (na raiz do projeto). Nenhuma variável é obrigatória: sem chaves a app usa football-data.co.uk.

# --- Serviços externos (opcionais) ---
# The Odds API (https://the-odds-api.com): odds ao vivo de mais operadores e outras linhas de golos.
# Plano gratuito ~500 créditos/mês; cada liga consultada custa 2 créditos. Deixe vazio para desativar.
ODDS_API_KEY=
ODDS_API_MIN_REMAINING=20
# Orçamento de créditos por período de faturação (o gasto é repartido ao longo do período) e dia em que o plano renova
ODDS_API_MONTHLY_BUDGET=500
ODDS_API_RESET_DAY=1

# odds-api.io (https://odds-api.io): única fonte encontrada com casas licenciadas pelo SRIJ (Betano PT, Betclic PT, Bwin PT).
# Planos pagos desde £49/mês (Solo = 2 casas à escolha); novas chaves grátis estão suspensas. Vazio = desativado.
ODDS_API_IO_KEY=
ODDS_API_IO_BOOKMAKERS=Betano PT,Betclic PT,Bwin PT

# Token para POST /api/admin/* (backtest, limpar cache). Vazio = administração desativada.
# Gere um valor longo e aleatório, ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Dados ---
LEAGUES=E0,SP1,I1,D1,F1,P1,N1
SEASONS_BACK=3
RESULTS_TTL_HOURS=12
FIXTURES_TTL_HOURS=1
ODDS_MAX_AGE_HOURS=48
# Atualização automática de jogos/odds em minutos (0 = desligada)
REFRESH_MINUTES=0

# --- Modelo e decisão ---
TIME_DECAY_XI=0.0019
# Peso do xG no alvo de treino (0 = só golos). 0.5 foi testado e não melhorou (ver README).
XG_WEIGHT=0
MIN_TEAM_MATCHES=10
EV_MARGIN=0.03
# Remoção da margem das casas: shin (corrige o viés favorito-azarão), power ou proportional
DEVIG_METHOD=shin
MAX_MARKET_DIVERGENCE=0.12
ODDS_OUTLIER=0.15
ODDS_MOVE_ALERT=0.08
